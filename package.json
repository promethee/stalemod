{
  "name": "stalemod",
  "version": "0.1.0",
  "description": "Scan your dev folders for stale, opted-in node_modules directories and report their size and location.",
  "keywords": [
    "node_modules",
    "disk-space",
    "cleanup",
    "cli",
    "npx",
    "stale",
    "storage"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "stalemod": "./bin/stalemod.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "main": "./dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/promethee/stalemod.git"
  }
}
